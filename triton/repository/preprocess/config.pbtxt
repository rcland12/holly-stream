name: "preprocess"
backend: "python"
max_batch_size: 0

input [
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

# Must match the object_detection input size. The letterbox size is read from these dims.
output [
  {
    name: "resized_image"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

version_policy: {
  latest: { num_versions: 1 }
}
