name: "object_detection"
platform: "onnxruntime_onnx"
max_batch_size: 0

# YOLO11 exported with NMS built in by triton/export.sh, which also sets the input dims below:
#   yolo export model=yolo11n.pt format=onnx imgsz=256,320 batch=1 dynamic=False simplify=True opset=17 nms=True conf=0.25 iou=0.45
# output0 rows are [x1, y1, x2, y2, score, class] in model input pixels, zero-padded to 300 rows.

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 256, 320 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 300, 6 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

# Leave a core for rpicam-vid, the capture loop and ffmpeg. With all 4 cores ONNX Runtime's worker
# threads contend with the stream and inference gets slower, not faster.
parameters { key: "intra_op_thread_count" value: { string_value: "3" } }
parameters { key: "inter_op_thread_count" value: { string_value: "1" } }

version_policy: {
  latest: { num_versions: 1 }
}
