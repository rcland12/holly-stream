name: "yolo11"
platform: "ensemble"
max_batch_size: 0

input [
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [ 720, 1280, 3 ]
  }
]

output [
  {
    name: "nms_num_dets"
    data_type: TYPE_INT32
    dims: [ 1, 1 ]
    label_filename: "labels.txt"
  },
  {
    name: "nms_boxes"
    data_type: TYPE_FP32
    dims: [ 1, 100, 4 ]
  },
  {
    name: "nms_scores"
    data_type: TYPE_FP32
    dims: [ 1, 100 ]
  },
  {
    name: "nms_classes"
    data_type: TYPE_INT32
    dims: [ 1, 100 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "preprocess"
      model_version: -1
      input_map {
        key: "image"
        value: "image"
      }
      output_map {
        key: "resized_image"
        value: "resized_image"
      }
    },
    {
      model_name: "object_detection"
      model_version: -1
      input_map {
        key: "images"
        value: "resized_image"
      }
      output_map {
        key: "nms_num_dets"
        value: "nms_num_dets"
      }
      output_map {
        key: "nms_boxes"
        value: "nms_boxes"
      }
      output_map {
        key: "nms_scores"
        value: "nms_scores"
      }
      output_map {
        key: "nms_classes"
        value: "nms_classes"
      }
    }
  ]
}

version_policy: { 
  latest: { num_versions: 1 }
}
