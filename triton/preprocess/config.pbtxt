name: "preprocess"
backend: "pytorch"
max_batch_size: 0

input [
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]
 
output [
  {
    name: "resized_image"
    data_type: TYPE_FP16
    dims: [ 1, 3, 640, 640 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    gpus: [ 0 ]
    count: 1
  }
]

optimization {
  execution_accelerators {
    gpu_execution_accelerator: [{ name: "pytorch"
      parameters { key: "enable_cuda_graph" value: "true" } }]
  }
}

version_policy: { 
  latest: { num_versions: 1 }
}
