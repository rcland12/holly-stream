name: "postprocess"
backend: "pytorch"
max_batch_size: 8

input [
  {
    name: "detections"
    data_type: TYPE_FP32
    dims: [ 84, 8400 ]
  }
]

output [
  {
    name: "boxes"
    data_type: TYPE_FP32
    dims: [ 300, 6 ]
  },
  {
    name: "num_dets"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    gpus: [ 0 ]
    count: 1
  }
]

dynamic_batching {
  preferred_batch_size: [ 1, 2, 4 ]
  max_queue_delay_microseconds: 800
}

optimization {
  execution_accelerators {
    gpu_execution_accelerator: [{ name: "pytorch"
      parameters { key: "enable_cuda_graph" value: "true" } }]
  }
}

version_policy: { 
  latest: { num_versions: 1 }
}
