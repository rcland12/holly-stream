# Holly Stream server settings. Copy to server/.env; apply changes with: docker compose up -d
# (add --profile detection when the detector is in use)

# ----- Ingest -----
# This server's LAN address, advertised to WebRTC viewers
SERVER_LAN_IP=
# Host port for the ingest's HLS player, if 8888 is already in use
HLS_PORT=8888
# Relay every camera on to another server, with {name} replaced by the camera's STREAM_NAME, e.g. an nginx-rtmp
# whose applications and stream keys match your stream names:
#   RELAY_URL=rtmp://192.168.1.10:1935/{name}
# Cameras with detection on are relayed with their detections drawn. Leave empty to only watch through the
# ingest itself (http://<server>:8888/<stream name>).
RELAY_URL=

# ----- Detector (docker compose --profile detection) -----
# An ONNX file in server/models/, created with ./export_model.sh. Inference on a GTX 1660 (TensorRT FP16, 480x640):
#   yolo26n ~2 ms    yolo26s ~4 ms    yolo26m ~8 ms (~10 ms in the live loop)
# Every camera with detection runs every frame, so they share a ~33 ms budget per 30 fps frame. yolo26m suits one
# or two such cameras; use yolo26s for three or more, or if the GPU is also busy with other work.
MODEL=yolo26m_480x640.onnx
# Class indexes to draw ("[]" for all); printed by export_model.sh. COCO: 0=person, 15=cat, 16=dog
CLASSES="[0, 16]"
CONFIDENCE_THRESHOLD=0.35
# 0 draws raw per-frame boxes; higher values steady them more (0.5 is a good balance)
BOX_SMOOTHING=0.5
# NVENC bitrate of streams with detections drawn
BITRATE_KBPS=4500
# Save an unannotated frame from each detection camera every N seconds to server/data/snapshots (0 = off)
SNAPSHOT_INTERVAL=0
# Log each camera's fps and timings every 10 seconds (status.sh shows the same numbers on demand)
LOG_STATS=false
