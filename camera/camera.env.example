# Holly Stream camera settings. install.sh copies this to /etc/holly-stream/camera.env; edit that file.
# Apply changes by restarting the camera: ./stop.sh && ./run.sh

# ----- Where this camera goes -----
# The Holly server's hostname (e.g. rusty or rusty.home.arpa) or LAN IP, and its SRT ingest port
SERVER_HOST=
SERVER_PORT=8890
# This camera's stream name. The server relays it under this name, e.g. to nginx-rtmp at <application>/<stream key>.
# Only one camera can use a name at a time.
STREAM_NAME=
# true to have the server draw object detections on this camera. Needs holly-detector running on the server;
# without it the camera streams plain until the detector comes up.
DETECTION=false
# 0, or 180 for a camera mounted upside down (the server flips it)
ROTATION=0
# SRT buffer for retransmitting lost packets. Raise to 500-1000 on a weak WiFi link.
SRT_LATENCY_MS=300

# ----- Video -----
# 1280x960 matches the 4:3 shape of most Pi camera modules and uses the whole sensor. 1280x720 gives a widescreen
# picture that fills a 16:9 player instead of being pillarboxed; it keeps the full width of the view and trims the
# top and bottom, so it shows less, not more (see SENSOR_MODE). Neither is wider than the lens itself: only a wider
# lens or camera module widens the view.
WIDTH=1280
HEIGHT=960
FPS=30
BITRATE_KBPS=6000
# Keep at 2 to line up with 2 second HLS segments downstream
KEYINT_SECONDS=2

# Digital zoom, from 1.0 (the whole sensor) up. 1.3 crops 30% in from every edge, which is a way to take the
# stretched edges off a fisheye lens or to frame out something you don't want in shot. The ISP applies it while
# scaling the frame, so it is free, and it costs no detail until the crop drops below WIDTHxHEIGHT.
ZOOM=1.0

# Sensor mode to capture in, as WxH, or auto, or none to let libcamera pick.
# auto chooses the smallest mode that reads the whole sensor and can still supply WIDTHxHEIGHT at FPS. It matters
# for a widescreen WIDTHxHEIGHT: left to itself libcamera picks a sensor mode that is already cropped in (asking an
# OV5647 for 1280x720 selects a mode that sees only 74% of the sensor's width and 56% of its height), while a
# full-sensor mode keeps the entire width and trims the top and bottom instead. Set none to go back to libcamera's
# own choice, or WxH to pin a mode listed by: rpicam-hello --list-cameras
SENSOR_MODE=auto

# Element between the camera and the hardware encoder: auto, none, videoconvert or v4l2convert.
# auto adds videoconvert on Raspberry Pi OS Bookworm (GStreamer before 1.24), where the encoder cannot take the
# camera's buffers directly and the stream would silently never start; it costs ~10% of a core. Trixie needs none.
#VIDEO_CONVERTER=auto

# libcamerasrc properties, space separated. List them with: gst-inspect-1.0 libcamerasrc
# e.g. exposure-value=0.5 brightness=0.1 awb-mode=indoor ae-metering-mode=matrix
CAMERA_OPTIONS="exposure-value=0.5"

# ----- Audio -----
# auto = first ALSA capture card, none = no audio, or a device such as plughw:1,0
AUDIO_DEVICE=auto
AUDIO_CHANNELS=1
AUDIO_BITRATE_KBPS=96
