# Holly Stream camera settings. Copy to camera/camera.env; apply changes with: ./stop.sh && ./run.sh

# ----- Where this camera goes -----
# The Holly server's hostname or LAN IP (127.0.0.1 when the server runs on this machine), and its SRT ingest port
SERVER_HOST=
SERVER_PORT=8890
# This camera's stream name. The server relays it under this name, e.g. to nginx-rtmp at <application>/<stream key>.
# Only one camera can use a name at a time.
STREAM_NAME=
# true to have the server draw object detections on this camera. Needs holly-detector running on the server;
# without it the camera streams plain until the detector comes up.
DETECTION=false
# SRT buffer for retransmitting lost packets. 200 is plenty on a wired LAN; raise to 500-1000 over WiFi.
SRT_LATENCY_MS=200

# ----- Camera -----
# auto = the first webcam, or a device such as /dev/video2, or a name from ls /dev/v4l/by-id (stays the same when
# the camera moves to another USB port), e.g. usb-046d_C922_Pro_Stream_Webcam_ABC123-video-index0
CAMERA_DEVICE=auto
# A size the camera lists (the log prints them if this one is not available). 1280x720 is the sweet spot for USB 2.0
# webcams; 1920x1080 also works at 30 fps in MJPEG.
WIDTH=1280
HEIGHT=720
FPS=30
# auto = H.264 from the camera if it has an encoder (sent as is, no rotation), else MJPEG, else raw YUYV
INPUT_FORMAT=auto
# v4l2 controls applied at start, space separated. List them with:
#   docker run --rm --device /dev/video0 rcland12/detection-stream:linux-camera-latest v4l2-ctl --list-ctrls
# (or v4l2-ctl --list-ctrls on the host). exposure_dynamic_framerate=0 stops Logitech cameras from halving the
# frame rate in dim light, which looks like stutter; the picture is darker instead. Other examples:
#   focus_automatic_continuous=0 focus_absolute=0 power_line_frequency=1 (50 Hz lighting)
CAMERA_CONTROLS="exposure_dynamic_framerate=0"
# 0, 90, 180 or 270 degrees clockwise, and HFLIP=true to mirror. Applied here, so plain and detection streams match.
ROTATION=0
HFLIP=false

# ----- Encoding -----
# auto = nvenc if an NVIDIA GPU works, else vaapi (Intel/AMD GPU), else x264 (CPU). run.sh starts the container with
# the GPU when it finds one. At 1280x720@30 on a 4-core server: nvenc ~0.25 core, x264 ~1.2 cores.
ENCODER=auto
# Which NVIDIA GPU decodes and encodes, as its index in nvidia-smi -L (default: the first)
#NVIDIA_GPU=0
BITRATE_KBPS=4000
# Keep at 2 to line up with 2 second HLS segments downstream
KEYINT_SECONDS=2

# ----- Audio -----
# auto = the webcam's own microphone (none if it has none), none = no audio, or an ALSA device such as plughw:1,0
AUDIO_DEVICE=auto
AUDIO_CHANNELS=1
AUDIO_BITRATE_KBPS=96

# Restart the pipeline if no frame is sent for this many seconds
WATCHDOG_SECONDS=15
