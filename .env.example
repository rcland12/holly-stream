# Settings for the machine you control the cameras from (e.g. the server or wherever your phone shortcut SSHes to).
# Copy to .env in the repository root.

# ----- Cameras, for run-all-cameras.sh / stop-all-cameras.sh / status-all-cameras.sh -----
# Each camera needs this repository cloned (any branch with run.sh, stop.sh and status.sh, so Raspberry Pi, Jetson
# and Linux cameras can be mixed) and SSH keys set up so it can be reached without a password.
CAMERA_HOSTNAMES=(rusty rustypi2 rustypi6)
# Optional, one per camera: SSH user (default: your SSH config or current user) and clone path under the home
# directory (default: dev/holly-stream)
#CAMERA_USERS=(russ pi pi)
#CAMERA_REPO_PATHS=(dev/holly-stream dev/holly-stream dev/holly-stream)
# Seconds to wait for each camera's run.sh or stop.sh before reporting it as still working
#CAMERA_COMMAND_TIMEOUT=150

# ----- docker-push.sh (maintainers) -----
#DOCKER_USERNAME=
#DOCKER_PASSWORD=
#LATEST_VERSION=
