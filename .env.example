# Copy to .env and adjust. Every setting is optional unless noted.

# --- RTMP destination ---------------------------------------------------------
# Local nginx on the Jetson (docker-compose up -d nginx):
#   VLC:     rtmp://<jetson>:1935/live/stream
#   Browser: http://<jetson>:8080/?key=stream
STREAM_IP=127.0.0.1
STREAM_PORT=1935
STREAM_APPLICATION=live
STREAM_KEY=stream
# Remote server instead, e.g.:
# STREAM_IP=rusty.home.arpa
# STREAM_APPLICATION=hollystream1
# STREAM_KEY=<secret>

# --- Camera -------------------------------------------------------------------
CAMERA_INDEX=0
# Sensor mode fed to the ISP; the hardware scaler resizes it to the output.
# IMX219 full field of view: 3264x1848 @ 28 fps.
CAPTURE_WIDTH=3264
CAPTURE_HEIGHT=1848
CAMERA_FPS=28
# white balance: 0 = off, 1 = auto
CAMERA_WBMODE=1
# temporal noise reduction: 0 = off, 1 = fast, 2 = high quality
CAMERA_TNR_MODE=2
# 0.0 - 1.0
CAMERA_TNR_STRENGTH=1

# --- Video --------------------------------------------------------------------
# 1080p | 720p | 540p | 480p | 360p | <W>x<H>
STREAM_RESOLUTION=720p
# ultra (VBR) | high | smooth | balanced | fast (CBR)
STREAM_QUALITY=smooth
# exact bitrate in bps, overrides STREAM_QUALITY
# VIDEO_BITRATE=2500000
# keyframe interval; matches the server's 2 s HLS fragments
GOP_SECONDS=2

# --- Audio --------------------------------------------------------------------
AUDIO_ENABLED=True
AUDIO_DEVICE=hw:2,0
AUDIO_BITRATE=96000
AUDIO_CHANNELS=1

# --- Object detection ---------------------------------------------------------
OBJECT_DETECTION=True
# file in models/; engine is built on first start
MODEL=yolo26n_640x384.onnx
# default: <model>_labels.txt next to the ONNX, else models/labels.txt
# MODEL_LABELS=
# names or ids ("[0, 16]"); empty = all 80 COCO classes
CLASSES="person, dog"
CONFIDENCE=0.4
# 0 = no NMS (YOLO26 is NMS-free); use 0.45 for YOLOv8/YOLO11
NMS_IOU=0
# frames skipped between inferences (0 = every frame)
INFERENCE_INTERVAL=0
# none | iou | nvdcf (keeps boxes moving on skipped frames)
TRACKER=none
SHOW_CONFIDENCE=True

# --- System -------------------------------------------------------------------
# pin CPU/GPU frequencies (jetson_clocks) and fan
MAX_PERFORMANCE=True
# seconds between [STATS] log lines
STATS_INTERVAL=10
# restart if nothing is sent for this long
WATCHDOG_SECONDS=20

# --- Multi-camera helpers (run/stop/status-all-cameras.sh) --------------------
# Cameras to control from this machine over SSH (keys, no password prompts). Any branch with run.sh, stop.sh and
# status.sh works, so Jetson, Raspberry Pi and Linux cameras can be mixed.
CAMERA_HOSTNAMES=(rustynano rustypi2)
# Optional, one per camera: SSH user (default: SSH config / current user) and clone path (default: dev/holly-stream)
#CAMERA_USERS=(russ russ)
#CAMERA_REPO_PATHS=(dev/holly-stream dev/holly-stream)
# Seconds to wait for each camera's run.sh or stop.sh before reporting it as still working
#CAMERA_COMMAND_TIMEOUT=150

# Where pip installed docker-compose, if it is not on the PATH of SSH sessions
DOCKER_COMPOSE_PATH=/home/russ/.local/bin

# --- docker-push.sh -----------------------------------------------------------
DOCKER_USERNAME=rcland12
# DOCKER_PASSWORD=
LATEST_VERSION=3.0
